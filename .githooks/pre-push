#!/bin/sh

COLOR_CYAN="\033[1;36m"
COLOR_GREEN="\033[1;32m"
COLOR_YELLOW="\033[1;33m"
COLOR_RED="\033[1;31m"
COLOR_RESET="\033[0m"

ZERO_SHA="0000000000000000000000000000000000000000"
EMPTY_TREE_SHA="4b825dc642cb6eb9a060e54bf8d69288fbee4904"

echo ""
echo "${COLOR_CYAN}===================================================${COLOR_RESET}"
echo "${COLOR_CYAN}     HEALTHCARE ECOSYSTEM - PRE-PUSH CHECK          ${COLOR_RESET}"
echo "${COLOR_CYAN}===================================================${COLOR_RESET}"
echo ""

if command -v go >/dev/null 2>&1; then
    echo "${COLOR_CYAN}[1/4] Running Go vet (go vet)...${COLOR_RESET}"
    if ! (cd backend && go vet ./...); then
        echo ""
        echo "${COLOR_RED}FAILED: 'go vet' found static analysis issues in Backend.${COLOR_RESET}"
        echo "${COLOR_RED}Please fix the errors above before pushing.${COLOR_RESET}"
        echo ""
        exit 1
    fi

    echo "${COLOR_CYAN}[2/4] Running RBAC gate (proto RPCs registered in policy)...${COLOR_RESET}"
    if ! (cd backend && go test -run TestEveryCompiledGRPCRPCIsRegisteredInPolicy ./internal/app/policy/...); then
        echo ""
        echo "${COLOR_RED}FAILED: some compiled proto RPC is not registered in policy.go.${COLOR_RESET}"
        echo "${COLOR_RED}Unregistered endpoints are blocked by default. Add the missing method to grpcMethodRoles or publicGRPCMethods.${COLOR_RESET}"
        echo ""
        exit 1
    fi
else
    echo "${COLOR_YELLOW}[!] 'go' not found in PATH. Skipping Backend checks.${COLOR_RESET}"
fi

pushed_files=""
while read local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$ZERO_SHA" ] && continue
    if [ "$remote_sha" = "$ZERO_SHA" ]; then
        changed_files=$(git diff --name-only "$EMPTY_TREE_SHA" "$local_sha")
    else
        changed_files=$(git diff --name-only "$remote_sha".."$local_sha")
    fi
    for changed_file in $changed_files; do
        case "$changed_file" in
            *.go|*.ts|*.tsx|*.js|*.jsx|*.mjs|*.cjs)
                pushed_files="$pushed_files $changed_file"
                ;;
        esac
    done
done

if [ -n "$pushed_files" ]; then
    echo "${COLOR_CYAN}[3/4] Running conventions check (no single-letter vars, no comments)...${COLOR_RESET}"
    if ! node scripts/conventions-check.mjs --files $pushed_files; then
        echo ""
        echo "${COLOR_RED}FAILED: conventions check found single-letter variables in the pushed files.${COLOR_RESET}"
        echo "${COLOR_RED}Use descriptive names (see AGENTS.MD). Fix and retry the push.${COLOR_RESET}"
        echo ""
        exit 1
    fi
else
    echo "${COLOR_CYAN}[3/4] Conventions check: no source files in this push.${COLOR_RESET}"
fi

if command -v npm >/dev/null 2>&1; then
    echo "${COLOR_CYAN}[4/4] Running Frontend lint (npm run lint)...${COLOR_RESET}"
    if ! (cd frontend && npm run lint); then
        echo ""
        echo "${COLOR_RED}FAILED: ESLint found quality warnings or errors in Frontend.${COLOR_RESET}"
        echo "${COLOR_RED}Please fix lint issues before pushing.${COLOR_RESET}"
        echo ""
        exit 1
    fi
else
    echo "${COLOR_YELLOW}[!] 'npm' not found in PATH. Skipping Frontend checks.${COLOR_RESET}"
fi

echo ""
echo "${COLOR_GREEN}===================================================${COLOR_RESET}"
echo "${COLOR_GREEN}     PRE-PUSH CHECK: PASSED SUCCESSFULLY           ${COLOR_RESET}"
echo "${COLOR_GREEN}===================================================${COLOR_RESET}"
echo ""

exit 0
