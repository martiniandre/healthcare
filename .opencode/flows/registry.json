{
  "flows": [
    {
      "id": "backend-module",
      "name": "Backend Module",
      "description": "Scaffolds a new Go gRPC domain module end-to-end (proto, pb stubs, model, repository, service, handler, register, RBAC, migration opcional, testes unitários).",
      "triggers": [
        "crie o módulo backend",
        "novo módulo go",
        "novo módulo backend",
        "backend module",
        "go-module-gen"
      ],
      "skill": "go-module-gen",
      "validate": [
        { "cwd": "backend", "command": "go build ./...", "label": "Build backend" },
        { "cwd": "backend", "command": "go vet ./...", "label": "Vet backend" },
        { "cwd": "backend", "command": "go test -v ./internal/modules/...", "label": "Testes unitários backend" }
      ],
      "commit": true
    },
    {
      "id": "frontend-module",
      "name": "Frontend Module",
      "description": "Scaffolds a new React/Vite domain module end-to-end (types, api, queries, schemas Zod, página, componentes, rota, i18n, testes Vitest + E2E Playwright offline).",
      "triggers": [
        "crie o módulo frontend",
        "novo módulo react",
        "novo módulo frontend",
        "frontend module",
        "frontend-module-gen"
      ],
      "skill": "frontend-module-gen",
      "validate": [
        { "cwd": "frontend", "command": "npm run lint", "label": "Lint frontend" },
        { "cwd": "frontend", "command": "npm run test", "label": "Testes unitários frontend (Vitest)" },
        { "cwd": "frontend", "command": "npm run build", "label": "Build frontend" },
        { "cwd": "frontend", "command": "npm run test:e2e", "label": "Testes E2E (Playwright)", "optional": true }
      ],
      "commit": true
    },
    {
      "id": "full-feature",
      "name": "Full Feature",
      "description": "Delivers a complete feature end-to-end: backend module com testes unitários, frontend module com testes Vitest + E2E Playwright, validações completas, commit+push e abertura de PR.",
      "triggers": [
        "full-feature",
        "feature completa",
        "implementa de ponta a ponta",
        "implementa tudo",
        "faz o módulo completo"
      ],
      "phases": [
        { "name": "Backend module (scaffold + testes unitários)", "skill": "go-module-gen" },
        { "name": "Frontend module (scaffold + testes Vitest + E2E)", "skill": "frontend-module-gen" }
      ],
      "validate": [
        { "cwd": "backend", "command": "go build ./...", "label": "Build backend" },
        { "cwd": "backend", "command": "go vet ./...", "label": "Vet backend" },
        { "cwd": "backend", "command": "go test -v ./internal/...", "label": "Testes unitários backend" },
        { "cwd": "frontend", "command": "npm run lint", "label": "Lint frontend" },
        { "cwd": "frontend", "command": "npm run test", "label": "Testes unitários frontend (Vitest)" },
        { "cwd": "frontend", "command": "npm run build", "label": "Build frontend" },
        { "cwd": "frontend", "command": "npm run test:e2e", "label": "Testes E2E (Playwright)", "optional": true }
      ],
      "commit": true,
      "openPr": true
    },
    {
      "id": "migration",
      "name": "Migration",
      "description": "Creates a new numbered SQL migration pair (up/down) in backend/migrations following the golang-migrate naming convention.",
      "triggers": [
        "crie a migration",
        "nova migration",
        "migration para",
        "migration-gen"
      ],
      "skill": "migration-gen",
      "validate": [],
      "commit": true
    },
    {
      "id": "changelog",
      "name": "Changelog",
      "description": "Generates CHANGELOG.md from the Conventional Commits history (node scripts/changelog.mjs) and commits the update.",
      "triggers": [
        "gera o changelog",
        "gerar changelog",
        "atualiza o changelog",
        "changelog"
      ],
      "validate": [],
      "commit": true
    },
    {
      "id": "issue-feature",
      "name": "Issue to Feature",
      "description": "Turns a GitHub issue into a complete feature: reads the issue with gh, creates a branch, scaffolds backend/frontend modules, registers RBAC endpoints, validates and opens a PR referencing the issue.",
      "triggers": [
        "implemente a issue",
        "issue-to-feature",
        "issue #",
        "issue para feature"
      ],
      "skill": "issue-to-feature",
      "validate": [
        { "cwd": "backend", "command": "go build ./...", "label": "Build backend" },
        { "cwd": "backend", "command": "go vet ./...", "label": "Vet backend" },
        { "cwd": "backend", "command": "go test -v ./internal/...", "label": "Testes unitários backend" },
        { "cwd": "frontend", "command": "npm run lint", "label": "Lint frontend" },
        { "cwd": "frontend", "command": "npm run test", "label": "Testes unitários frontend (Vitest)" },
        { "cwd": "frontend", "command": "npm run build", "label": "Build frontend" },
        { "cwd": "frontend", "command": "npm run test:e2e", "label": "Testes E2E (Playwright)", "optional": true }
      ],
      "commit": true,
      "openPr": true
    },
    {
      "id": "finalize",
      "name": "Finalize",
      "description": "Validates the changed areas, commits with Conventional Commits v1.0.0 and pushes immediately to the active branch.",
      "triggers": [
        "commit e push",
        "publique",
        "publicar",
        "finaliza o marco",
        "finalize",
        "healthcare-commit"
      ],
      "skill": "healthcare-commit",
      "validate": [],
      "commit": true
    },
    {
      "id": "review",
      "name": "Review",
      "description": "Runs fast validations (go vet + npm lint) and opens the PR for review.",
      "triggers": [
        "revisa",
        "revisar",
        "review",
        "code review",
        "abre o pr"
      ],
      "validate": [
        { "cwd": "backend", "command": "go vet ./...", "label": "Vet backend" },
        { "cwd": "frontend", "command": "npm run lint", "label": "Lint frontend" }
      ],
      "commit": false,
      "openPr": true
    }
  ]
}
